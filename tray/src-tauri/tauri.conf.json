{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Sync",
  "version": "0.1.0",
  "identifier": "com.oogxdd.chatgpt-sync-tray",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ChatGPT Sync",
        "width": 460,
        "height": 620,
        "minWidth": 380,
        "minHeight": 360,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
